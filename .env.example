# PayLab does not require provider API keys for simulated webhooks.
# These are local simulation secrets used by the demo merchant.
PAYLAB_PAYSTACK_SECRET=sk_test_example
PAYLAB_STRIPE_WEBHOOK_SECRET=whsec_example
PAYLAB_FLUTTERWAVE_SECRET=flw_example

# SQLite is the zero-config default.
PAYLAB_DB_PATH=.paylab/paylab.db

# Optional PostgreSQL history backend. When set, this takes precedence over PAYLAB_DB_PATH.
# PAYLAB_DATABASE_URL=postgresql://paylab:paylab@127.0.0.1:5432/paylab

# Optional Redis Pub/Sub backend for cross-process live dashboard/WebSocket events.
# PAYLAB_REDIS_URL=redis://127.0.0.1:6379/0
# PAYLAB_REDIS_CHANNEL=paylab:events
