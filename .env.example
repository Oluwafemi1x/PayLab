# PayLab does not require provider API keys for simulated webhooks.
# These are local simulation secrets used by the demo merchant.
PAYLAB_PAYSTACK_SECRET=sk_test_example
PAYLAB_STRIPE_WEBHOOK_SECRET=whsec_example
PAYLAB_FLUTTERWAVE_SECRET=flw_example

# Optional. Defaults to ~/.paylab/paylab.db
PAYLAB_DB_PATH=.paylab/paylab.db
